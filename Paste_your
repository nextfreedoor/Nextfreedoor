<!DOCTYPE html>
<html lang="en">
<head>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6940277987635940"
     crossorigin="anonymous"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Next Free Door - Treasure Valley</title>

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6940277987635940" crossorigin="anonymous"></script>

  <!-- Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root {
      --teal-dark: #072b2b;
      --teal-main: #0b3c3c;
      --teal-light: #124e4e;
      --gold: #f4c430;
      --bg: #f4f6f6;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: #222;
    }
    header {
      background: var(--teal-main);
      color: white;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .logo {
      font-weight: 700;
      font-size: 1.25rem;
      color: white;
      text-decoration: none;
    }
    .logo span { color: var(--gold); }
    .btn {
      background: var(--gold);
      color: var(--teal-dark);
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
    }
    .btn-outline {
      background: transparent;
      border: 2px solid var(--gold);
      color: var(--gold);
      padding: 6px 12px;
      border-radius: 6px;
      font-weight: 600;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 16px;
    }
    .hero {
      background: var(--teal-main);
      color: white;
      padding: 24px 20px;
      border-radius: 12px;
      margin-bottom: 20px;
    }
    .hero h1 { font-size: 1.5rem; margin-bottom: 8px; }
    .hero h1 span { color: var(--gold); }
    .hero p { color: #c8d4d4; font-size: 0.95rem; }
    .cats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 20px;
    }
    @media(min-width:500px){ .cats{ grid-template-columns: repeat(4,1fr); } }
    .cat {
      background: white;
      border: 2px solid #ddd;
      padding: 12px;
      border-radius: 10px;
      text-align: center;
      font-weight: 600;
      cursor: pointer;
    }
    .cat.active, .cat:hover {
      border-color: var(--teal-main);
      background: #e6f0f0;
    }
    .card {
      background: white;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .card h2 { color: var(--teal-dark); margin-bottom: 16px; font-size: 1.2rem; }
    .form-group { margin-bottom: 14px; }
    label { display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.9rem; }
    input, select, textarea {
      width: 100%;
      padding: 11px;
      border: 1px solid #ddd;
      border-radius: 7px;
      font-size: 1rem;
      font-family: inherit;
    }
    .publish {
      background: var(--teal-main);
      color: white;
      border: none;
      padding: 13px;
      border-radius: 7px;
      font-weight: 700;
      width: 100%;
      font-size: 1rem;
      cursor: pointer;
    }
    .listing {
      background: white;
      border: 1px solid #ddd;
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 14px;
    }
    .listing-header {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      font-weight: 700;
      color: var(--teal-dark);
      margin-bottom: 6px;
    }
    .tag {
      background: var(--gold);
      color: var(--teal-dark);
      padding: 3px 8px;
      border-radius: 5px;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .media { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
    .media img, .media video {
      max-width: 110px;
      max-height: 110px;
      border-radius: 6px;
      object-fit: cover;
    }
    .human { display: flex; align-items: center; gap: 8px; margin: 14px 0; }
    footer {
      background: var(--teal-dark);
      color: white;
      text-align: center;
      padding: 24px 16px;
      margin-top: 30px;
      font-size: 0.9rem;
    }
    footer a { color: var(--gold); margin: 0 8px; }
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 200;
      align-items: center;
      justify-content: center;
    }
    .modal.show { display: flex; }
    .modal-box {
      background: white;
      padding: 24px;
      border-radius: 12px;
      width: 90%;
      max-width: 380px;
    }
    .error { color: #c0392b; font-size: 0.9rem; margin-top: 8px; }
    .success { color: #27ae60; font-size: 0.9rem; margin-top: 8px; }
    .btn-del {
      background: #e74c3c;
      color: white;
      border: none;
      padding: 5px 10px;
      border-radius: 5px;
      font-size: 0.8rem;
      cursor: pointer;
    }
  </style>
</head>
<body>

<header>
  <a href="/" class="logo">Next <span>Free</span> Door</a>
  <div id="nav"></div>
</header>

<div class="container">
  <div class="hero">
    <h1>Your Treasure Valley. Your Community. <span>100% Free</span>.</h1>
    <p>Buy, sell, trade, give things away, find side gigs across Boise, Meridian, Nampa, Caldwell & Eagle.</p>
  </div>

  <div class="cats">
    <div class="cat active" data-cat="all" onclick="filterCat('all')">All Posts</div>
    <div class="cat" data-cat="free" onclick="filterCat('free')">🎁 Free Stuff</div>
    <div class="cat" data-cat="buysell" onclick="filterCat('buysell')">🛒 Buy / Sell</div>
    <div class="cat" data-cat="gigs" onclick="filterCat('gigs')">💼 Side Gigs</div>
  </div>

  <div class="card" id="createCard" style="display:none;">
    <h2>Create a Free Post</h2>
    <div class="form-group">
      <label>Category</label>
      <select id="category">
        <option value="Free Giveaway">Free Giveaway</option>
        <option value="For Sale">For Sale</option>
        <option value="Trade">Trade</option>
        <option value="Side Gig / Work">Side Gig / Work</option>
        <option value="Local News">Local News</option>
      </select>
    </div>
    <div class="form-group">
      <label>Title</label>
      <input type="text" id="title" placeholder="What are you offering?">
    </div>
    <div class="form-group">
      <label>Location</label>
      <input type="text" id="location" placeholder="Boise, Meridian, Nampa...">
    </div>
    <div class="form-group">
      <label>Description & Contact</label>
      <textarea id="desc" rows="4" placeholder="Details + how to reach you"></textarea>
    </div>
    <div class="form-group">
      <label>Images (max 10)</label>
      <input type="file" id="images" accept="image/*" multiple>
    </div>
    <div class="form-group">
      <label>Video (optional)</label>
      <input type="file" id="video" accept="video/*">
    </div>
    <div class="human">
      <input type="checkbox" id="human">
      <label for="human">I am human</label>
    </div>
    <button class="publish" id="publishBtn" onclick="createPost()">Publish Free Post</button>
    <div id="postMsg"></div>
  </div>

  <h2 style="color:var(--teal-dark); margin: 10px 0 15px;">Community Feed</h2>
  <div id="feed">Loading posts...</div>
</div>

<footer>
  <p>© 2026 Next Free Door • 100% Free for Treasure Valley, Idaho</p>
  <div style="margin-top:10px;">
    <a href="#">Contact</a> | <a href="#">Privacy</a> | <a href="#">Terms</a>
  </div>
</footer>

<!-- Auth Modal -->
<div class="modal" id="authModal">
  <div class="modal-box">
    <h2 id="authTitle">Sign In</h2>
    <div class="form-group">
      <label>Email</label>
      <input type="email" id="email" placeholder="you@email.com">
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" id="password" placeholder="••••••••">
    </div>
    <button class="publish" id="authBtn" onclick="handleAuth()">Sign In</button>
    <div id="authMsg"></div>
    <p style="text-align:center; margin-top:14px; font-size:0.9rem;">
      <a href="#" id="toggleAuth" onclick="toggleMode(); return false;">Need an account? Sign Up</a>
    </p>
  </div>
</div>

<script>
  // ========== PUT YOUR SUPABASE KEYS HERE ==========
  const SUPABASE_URL = 'PASTE_YOUR_PROJECT_URL_HERE';
  const SUPABASE_ANON_KEY = 'PASTE_YOUR_ANON_KEY_HERE';
  // ================================================

  const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  let user = null;
  let filter = 'all';
  let mode = 'login';

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    user = session?.user || null;
    updateNav();
    loadPosts();

    supabase.auth.onAuthStateChange((event, session) => {
      user = session?.user || null;
      updateNav();
      loadPosts();
    });
  }

  function updateNav() {
    const nav = document.getElementById('nav');
    const card = document.getElementById('createCard');
    if (user) {
      nav.innerHTML = `<span style="color:white;font-size:0.9rem;margin-right:8px;">${user.email.split('@')[0]}</span>
                       <button class="btn" onclick="signOut()">Sign Out</button>`;
      card.style.display = 'block';
    } else {
      nav.innerHTML = `<button class="btn-outline" onclick="openModal('login')">Sign In</button>
                       <button class="btn" onclick="openModal('signup')">Sign Up</button>`;
      card.style.display = 'none';
    }
  }

  function openModal(m) {
    mode = m;
    document.getElementById('authTitle').textContent = m === 'login' ? 'Sign In' : 'Sign Up';
    document.getElementById('authBtn').textContent = m === 'login' ? 'Sign In' : 'Create Account';
    document.getElementById('toggleAuth').textContent = m === 'login' ? 'Need an account? Sign Up' : 'Already have an account? Sign In';
    document.getElementById('authMsg').innerHTML = '';
    document.getElementById('authModal').classList.add('show');
  }

  function toggleMode() {
    openModal(mode === 'login' ? 'signup' : 'login');
  }

  async function handleAuth() {
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const msg = document.getElementById('authMsg');
    if (!email || !password) return msg.innerHTML = '<div class="error">Fill both fields</div>';

    msg.innerHTML = 'Please wait...';
    if (mode === 'login') {
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) msg.innerHTML = `<div class="error">${error.message}</div>`;
      else document.getElementById('authModal').classList.remove('show');
    } else {
      const { error } = await supabase.auth.signUp({ email, password });
      if (error) msg.innerHTML = `<div class="error">${error.message}</div>`;
      else msg.innerHTML = '<div class="success">Check your email to confirm!</div>';
    }
  }

  async function signOut() {
    await supabase.auth.signOut();
  }

  document.getElementById('authModal').onclick = e => {
    if (e.target.id === 'authModal') e.target.classList.remove('show');
  };

  async function createPost() {
    if (!user) return alert('Please sign in first');
    const category = document.getElementById('category').value;
    const title = document.getElementById('title').value.trim();
    const location = document.getElementById('location').value.trim();
    const description = document.getElementById('desc').value.trim();
    const human = document.getElementById('human').checked;
    const imageFiles = document.getElementById('images').files;
    const videoFile = document.getElementById('video').files[0];
    const msg = document.getElementById('postMsg');
    const btn = document.getElementById('publishBtn');

    if (!title || !description) return msg.innerHTML = '<div class="error">Title & description required</div>';
    if (!human) return msg.innerHTML = '<div class="error">Please check "I am human"</div>';
    if (imageFiles.length > 10) return msg.innerHTML = '<div class="error">Max 10 images</div>';

    btn.disabled = true;
    btn.textContent = 'Publishing...';
    msg.innerHTML = '';

    try {
      const imageUrls = [];
      for (let i = 0; i < imageFiles.length; i++) {
        const file = imageFiles[i];
        const path = `\( {user.id}/ \){Date.now()}_\( {i}_ \){file.name}`;
        const { error } = await supabase.storage.from('listings').upload(path, file);
        if (error) throw error;
        const { data } = supabase.storage.from('listings').getPublicUrl(path);
        imageUrls.push(data.publicUrl);
      }

      let videoUrl = null;
      if (videoFile) {
        const path = `\( {user.id}/ \){Date.now()}_video_${videoFile.name}`;
        const { error } = await supabase.storage.from('listings').upload(path, videoFile);
        if (error) throw error;
        const { data } = supabase.storage.from('listings').getPublicUrl(path);
        videoUrl = data.publicUrl;
      }

      const { error } = await supabase.from('posts').insert({
        user_id: user.id,
        category,
        title,
        location: location || 'Treasure Valley',
        description,
        images: imageUrls,
        video_url: videoUrl
      });
      if (error) throw error;

      document.getElementById('title').value = '';
      document.getElementById('location').value = '';
      document.getElementById('desc').value = '';
      document.getElementById('images').value = '';
      document.getElementById('video').value = '';
      document.getElementById('human').checked = false;
      msg.innerHTML = '<div class="success">Published!</div>';
      loadPosts();
    } catch (err) {
      msg.innerHTML = `<div class="error">${err.message}</div>`;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Publish Free Post';
    }
  }

  async function loadPosts() {
    const feed = document.getElementById('feed');
    feed.innerHTML = 'Loading...';

    const { data: posts, error } = await supabase
      .from('posts')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) {
      feed.innerHTML = `<p style="color:#c0392b;">Error: ${error.message}</p>`;
      return;
    }

    let list = posts || [];
    if (filter === 'free') list = list.filter(p => p.category === 'Free Giveaway');
    if (filter === 'buysell') list = list.filter(p => ['For Sale','Trade'].includes(p.category));
    if (filter === 'gigs') list = list.filter(p => p.category === 'Side Gig / Work');

    if (!list.length) {
      feed.innerHTML = '<p style="text-align:center;color:#666;">No posts yet. Be the first!</p>';
      return;
    }

    feed.innerHTML = list.map(p => {
      const isOwner = user && user.id === p.user_id;
      const date = new Date(p.created_at).toLocaleDateString();
      let media = '';
      if (p.images?.length) {
        media += `<div class="media">\( {p.images.map(img => `<img src=" \){img}" loading="lazy">`).join('')}</div>`;
      }
      if (p.video_url) {
        media += `<div class="media"><video src="${p.video_url}" controls style="max-width:100%;max-height:220px;border-radius:8px;"></video></div>`;
      }
      return `
        <div class="listing">
          <div class="listing-header">
            <span>${esc(p.title)}</span>
            <span class="tag">${esc(p.category)}</span>
          </div>
          <p style="margin:8px 0;">${esc(p.description)}</p>
          ${media}
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;flex-wrap:wrap;gap:8px;">
            <small style="color:#888;">📍 ${esc(p.location)} • ${date}</small>
            \( {isOwner ? `<button class="btn-del" onclick="deletePost(' \){p.id}')">Delete</button>` : ''}
          </div>
        </div>`;
    }).join('');
  }

  async function deletePost(id) {
    if (!confirm('Delete this post?')) return;
    await supabase.from('posts').delete().eq('id', id);
    loadPosts();
  }

  function filterCat(cat) {
    filter = cat;
    document.querySelectorAll('.cat').forEach(c => c.classList.toggle('active', c.dataset.cat === cat));
    loadPosts();
  }

  function esc(t) {
    if (!t) return '';
    return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  init();
</script>
</body>
</html>
