<!DOCTYPE html>
<html lang="en">
<head>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6940277987635940"
     crossorigin="anonymous"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Next Free Door - Treasure Valley</title>

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6940277987635940" crossorigin="anonymous"></script>

  <!-- Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root {
      --teal-dark: #072b2b;
      --teal-main: #0b3c3c;
      --teal-light: #124e4e;
      --gold: #f4c430;
      --bg: #f4f6f6;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: #222;
    }
    header {
      background: var(--teal-main);
      color: white;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .logo {
      font-weight: 700;
      font-size: 1.25rem;
      color: white;
      text-decoration: none;
    }
    .logo span { color: var(--gold); }
    .btn {
      background: var(--gold);
      color: var(--teal-dark);
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
    }
    .btn-outline {
      background: transparent;
      border: 2px solid var(--gold);
      color: var(--gold);
      padding: 6px 12px;
      border-radius: 6px;
      font-weight: 600;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 16px;
    }
    .hero {
      background: var(--teal-main);
      color: white;
      padding: 24px 20px;
      border-radius: 12px;
      margin-bottom: 20px;
    }
    .hero h1 { font-size: 1.5rem; margin-bottom: 8px; }
    .hero h1 span { color: var(--gold); }
    .hero p { color: #c8d4d4; font-size: 0.95rem; }
    .cats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 20px;
    }
    @media(min-width:500px){ .cats{ grid-template-columns: repeat(4,1fr); } }
    .cat {
      background: white;
      border: 2px solid #ddd;
      padding: 12px;
      border-radius: 10px;
      text-align: center;
      font-weight: 600;
      cursor: pointer;
    }
    .cat.active, .cat:hover {
      border-color: var(--teal-main);
      background: #e6f0f0;
    }
